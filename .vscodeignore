# vsce includes everything not listed here. The shipped VSIX should only
# contain the production esbuild output, the webview assets, the icon, and
# the user-facing README / LICENSE / CHANGELOG.

# Source
src/**
test/**

# Source-map artefacts (never shipped — strip even if a dev build wrote one)
**/*.map

# Anything TypeScript
**/*.ts
**/*.test.ts
**/__fixtures__/**
**/__mocks__/**

# Build / lint / test configuration
vitest.config.ts
tsconfig.json
esbuild.config.mjs
.eslintrc.cjs
.eslint*

# Tooling and CI
node_modules/**
.vscode-test/**
.vscode/**
.github/**
scripts/**

# BRAINS Build Platform run-state, internal docs, prose-lint config
.brains-build/**
docs/**
package-output.txt
.vale/**
.vale.ini
.markdownlint.json
.gitleaks.toml

# Repo-only metadata (lives on GitHub, not in the VSIX)
.gitignore
.gitattributes
SECURITY.md
CODE_OF_CONDUCT.md
CONTRIBUTING.md
*.code-workspace

# OS / editor cruft
**/Thumbs.db
*.code-workspace

# We ship the rendered PNG icon, not the SVG source
assets/icon.svg
# README screenshot + cert badge — referenced via GitHub raw URL, not packaged in the VSIX
assets/screenshot.png
assets/badges/**
!assets/icon.png
!assets/sidebar-icon.svg

# Production bundle + webview assets — these MUST be in the VSIX
!dist/webview/**
!dist/extension.js

# User-facing docs that the Marketplace surfaces
!README.md
!LICENSE
!CHANGELOG.md
